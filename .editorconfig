root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Same limit as detekt's MaxLineLength.
max_line_length = 120
ktlint_code_style = ktlint_official

[*.{yml,yaml,toml,json,ftlh}]
indent_size = 2

[Makefile]
indent_style = tab
